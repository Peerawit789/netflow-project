          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "from": 0,
                "to": 0.5,
                "result": {
                  "color": "green",
                  "text": "SYSTEM OK: Normal Traffic Baselines"
                }
              },
              "type": "range"
            },
            {
              "options": {
                "from": 0.5,
                "to": 0.8,
                "result": {
                  "color": "orange",
                  "text": "EVALUATING: Traffic Anomaly Under Verification"
                }
              },
              "type": "range"
            },
            {
              "options": {
                "from": 0.8,
                "to": 1.0,
                "result": {
                  "color": "red",
                  "text": "ATTACK DETECTED: Automated Response Policy Triggered"
                }
              },
              "type": "range"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 0.8
              }
            ]
          }
        },
        "overrides": []
      },
